<Window x:Class="MachineSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MachineSim : simulateur de centre d'usinage"
        Height="540" Width="960"
        Background="#1E1E24" Foreground="#E0E0E0">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════════ Colonne 1 : commandes ═════════════ -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="COMMANDES" FontWeight="Bold" Margin="0,0,0,12" />
            
            <Button Content="Connecter" Command="{Binding ConnectCommand}" />
            <Button Content="Démarrer programme" Command="{Binding StartCommand}"/>
            <Button Content="Arrêter" Command="{Binding StopCommand}"/>
            <Button Content="Acquitter alarme" Command="{Binding AcknowledgeCommand}"/>

            <TextBlock Text="ÉTAT" FontWeight="Bold" Margin="0,20,0,4" />
            <TextBlock Text="{Binding State}" FontSize="22" />
            <!-- Bonus : colorer l'état (vert/orange/rouge) avec un IValueConverter ou des DataTriggers -->
        </StackPanel>

        <!-- ═════════════ Colonne 2 : visualisation ═════════════ -->
        <StackPanel Grid.Column="1" Margin="16,0" HorizontalAlignment="Center">
            <TextBlock Text="POSITION OUTIL" FontWeight="Bold" Margin="0,0,0,12" />

            <Border BorderBrush="#444" BorderThickness="1" Background="#14141A">
                <!-- Le Viewbox met à l'échelle : le Canvas fait 100 x 100 "mm", affiché en 300 x 300 px -->
                <Viewbox Width="300" Height="300">
                    <Canvas Width="100" Height="100">
                        <!-- Pièce brute -->
                        <Rectangle Canvas.Left="5" Canvas.Top="5" Width="90" Height="90"
                                   Stroke="#555" StrokeThickness="0.5" />

                        <!-- Outil -->
                        <Ellipse Width="4" Height="4" Fill="OrangeRed"
                                 Canvas.Left="{Binding PositionX}" Canvas.Top="{Binding PositionY}">
                            <Ellipse.RenderTransform>
                                <!-- Centre le point sur la position (rayon = 2) -->
                                <TranslateTransform X="-2" Y="-2" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Viewbox>
            </Border>
            
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                <TextBlock Text="{Binding PositionX, StringFormat='X = {0:F2} mm'}" Width="110" FontFamily="Consolas" FontSize="14" />
                <TextBlock Text="{Binding PositionY, StringFormat='Y = {0:F2} mm'}" Width="110" FontFamily="Consolas" FontSize="14" />
                <TextBlock Text="{Binding PositionZ, StringFormat='Z = {0:F2} mm'}" Width="110" FontFamily="Consolas" FontSize="14" />
            </StackPanel>
        </StackPanel>

        <!-- ═════════════ Colonne 3 : alarmes ═════════════ -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="HISTORIQUE DES ALARMES"
                       FontWeight="Bold" Margin="0,0,0,12" />
            <ListBox ItemsSource="{Binding Alarms}"
                     Background="#14141A" Foreground="#FF8A80" BorderBrush="#444"
                     FontFamily="Consolas" />
        </DockPanel>

        <!-- ═════════════ Barre de statut ═════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#2A2A33"
                Padding="10,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" />
        </Border>
    </Grid>
</Window>
